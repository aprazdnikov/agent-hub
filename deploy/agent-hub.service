[Unit]
Description=agent-hub: Telegram forum topics as AI agent sessions
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/aprazdnikov/agent-hub
EnvironmentFile=%h/.config/agent-hub/env
# systemd user services get a minimal PATH; uv and claude usually live in ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run --locked agent-hub
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
