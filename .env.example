# Скопируйте в .env (или ~/.config/agent-hub/env для systemd) и заполните.
# Один и тот же .env подходит и для запуска на хосте, и для Docker Compose.

# Токен бота от @BotFather.
AGENT_HUB_TELEGRAM_TOKEN=123456789:AA...

# ID форум-группы (начинается с -100). Как узнать — см. README.
AGENT_HUB_CHAT_ID=-1001234567890

# Telegram user id тех, кому разрешено управлять ботом, через запятую.
AGENT_HUB_ALLOWED_USER_IDS=123456789

# Корень, за пределы которого сессии не могут выйти; рабочая директория по умолчанию.
# При запуске на хосте. В Docker игнорируется — там корень всегда /workspace.
AGENT_HUB_WORKSPACE_ROOT=~/Projects

# --- только для Docker Compose ---

# Директория хоста, которая монтируется в контейнер как /workspace.
AGENT_HUB_HOST_WORKSPACE=/home/you/Projects

# UID/GID вашего пользователя (`id -u`, `id -g`), чтобы файлы в /workspace
# создавались от вашего имени.
# AGENT_HUB_UID=1000
# AGENT_HUB_GID=1000

# Авторизация Claude в контейнере, если не делать `claude /login` внутри (см. README).
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=...

# --- необязательные ---

# Где хранить привязку «тема → сессия».
# AGENT_HUB_STATE_FILE=~/.local/state/agent-hub/topics.json

# Сколько секунд ждать нажатия «Разрешить/Запретить», потом — запрет.
# AGENT_HUB_APPROVAL_TIMEOUT_SECONDS=600

# default | acceptEdits | plan | bypassPermissions
# AGENT_HUB_CLAUDE_PERMISSION_MODE=default

# Модель Claude; по умолчанию — модель из настроек Claude Code.
# AGENT_HUB_CLAUDE_MODEL=claude-opus-5-5

# Лимит стоимости одного сообщения-задачи в USD.
# AGENT_HUB_CLAUDE_MAX_BUDGET_USD=5
